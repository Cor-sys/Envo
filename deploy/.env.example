# Copy to deploy/.env and fill in. Generate the four secrets with:
#   node deploy/gen-keys.mjs
# Then set the public URL + port to match the box this runs on.

# --- secrets (from `node deploy/gen-keys.mjs`) ---
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

# --- where the app is reached on your network ---
# Use the LAN address (or hostname) of the machine running this stack, INCLUDING
# the port. The bundle bakes this in, so rebuild (`up -d --build`) if it changes.
#   examples: http://192.168.1.50:8080   http://stockroom.local:8080
SUPABASE_PUBLIC_URL=http://localhost:8080

# Host port the app is served on (left side of the mapping).
HTTP_PORT=8080
