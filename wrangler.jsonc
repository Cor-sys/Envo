{
  // Workers Static Assets deploy config for Cloudflare Pages-via-Workers.
  // Tells `wrangler deploy` to upload the Vite build output (./dist) and serve
  // it as a static SPA, falling back to index.html for any unknown path so
  // React Router can handle nested routes like /items/<id>.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "envo",
  "compatibility_date": "2026-05-21",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
