# Copy to .env.local and fill in from your Supabase project's API settings.
# Vite exposes only VITE_-prefixed vars to the client bundle.
#
# Production / real-data dev:
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Demo mode for frontend devs who don't have Supabase access.
# Uncomment the next line and you can skip the two values above. The app will
# load with hardcoded sample bulbs/tools/paint/chemicals/belts/supplies and a
# fake signed-in session. See ONBOARDING.md for the full setup.
# VITE_DEMO_MODE=true
